PORT=3000
HOST=0.0.0.0
# Vacío = webhook desactivado (modo demo de la práctica, /webhook -> 503).
# Mínimo 32 caracteres cuando se active en producción.
WEBHOOK_SECRET=
CONFIG_PATH=./hookdeploy.config.json
DRY_RUN=true
DEPLOY_TIMEOUT_MS=300000
MAX_BODY_BYTES=1048576
HISTORY_SIZE=20
STATUS_TOKEN=
LOG_LEVEL=info
GIT_SHA=unknown
GIT_REF=unknown
BUILD_DATE=unknown
RUN_NUMBER=unknown
RUN_URL=unknown
